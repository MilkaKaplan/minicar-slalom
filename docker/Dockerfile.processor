# Container 2: processing.
#   processor node: sensor_msgs/Image -> posts -> slalom path -> PNG + JSON + CSV
#   simulator node: drives a simulated car along that path -> PNG + GIF + JSON
# ros:jazzy-ros-base = Ubuntu 24.04 (noble) + ROS 2 Jazzy + Python 3.12
FROM ros:jazzy-ros-base

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3-numpy \
        python3-scipy \
        python3-matplotlib \
        python3-pil \
        python3-opencv \
        ros-jazzy-rmw-cyclonedds-cpp \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /ros2_ws
COPY ros2_ws/src/minicar_processor src/minicar_processor
COPY ros2_ws/src/minicar_simulator src/minicar_simulator
RUN . /opt/ros/jazzy/setup.sh && colcon build --packages-select minicar_processor minicar_simulator

ENV MPLCONFIGDIR=/tmp/matplotlib
COPY docker/entrypoint.sh /entrypoint.sh
COPY docker/processing.launch.py /ros2_ws/processing.launch.py
COPY docker/lidar.launch.py /ros2_ws/lidar.launch.py
RUN chmod +x /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh"]
CMD ["ros2", "launch", "/ros2_ws/processing.launch.py"]
