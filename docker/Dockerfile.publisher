# Container 1: data acquisition - replays the iPhone LiDAR recording
# (depth + confidence + phone pose) as live ROS 2 sensor topics.
# ros:jazzy-ros-base = Ubuntu 24.04 (noble) + ROS 2 Jazzy + Python 3.12
FROM ros:jazzy-ros-base

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3-numpy \
        python3-pil \
        ros-jazzy-rmw-cyclonedds-cpp \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /ros2_ws
COPY ros2_ws/src/minicar_publisher src/minicar_publisher
RUN . /opt/ros/jazzy/setup.sh && colcon build --packages-select minicar_publisher

COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh"]
# Run the node directly (not via "ros2 run"), so it receives the stop signal from Docker
CMD ["/ros2_ws/install/minicar_publisher/lib/minicar_publisher/lidar_replay_node", "--ros-args", \
     "-p", "recording_dir:=/data/lidar_drive"]